{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://unpkg.com/fe-stub/schema.json",
  "title": "fe-stub stub file",
  "definitions": {
    "stub": {
      "type": "object",
      "required": ["endpoint", "response"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "description": "Label shown in logs and `fe-stub list`." },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "*",
                   "get", "post", "put", "patch", "delete", "head", "options"],
          "default": "GET"
        },
        "endpoint": {
          "type": "string",
          "description": "Path (\"/api/users/:id\", \"/api/files/*\") or absolute URL (\"https://api.example.com/users\")."
        },
        "enabled": { "type": "boolean", "default": true },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "query": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": { "description": "Partial deep match against the JSON request body." }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599, "default": 200 },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } },
            "body": { "description": "Any JSON. Strings support {{params.x}}, {{query.x}}, {{body.x}}." },
            "bodyFile": { "type": "string", "description": "JSON file relative to this stub file; inlined at build time." },
            "delay": { "type": "integer", "minimum": 0, "default": 0, "description": "Latency in ms." }
          }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/stub" },
    { "type": "array", "items": { "$ref": "#/definitions/stub" } },
    {
      "type": "object",
      "required": ["stubs"],
      "properties": {
        "$schema": { "type": "string" },
        "stubs": { "type": "array", "items": { "$ref": "#/definitions/stub" } }
      }
    }
  ]
}
