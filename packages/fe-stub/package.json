{
  "name": "fe-stub",
  "version": "0.2.0",
  "description": "A local stub API for frontend development (React, Angular, Vue...). Serves HTTP responses from JSON files on its own port, and forwards everything else to your real API.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "fe-stub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schema.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "stub",
    "mock",
    "mock-server",
    "api",
    "react",
    "angular",
    "vue",
    "frontend",
    "dev"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
