{
  "name": "baserepo/messenger-ai-bot",
  "description": "Facebook Messenger AI chatbot built to fix the 10 most common Messenger bot failures.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-curl": "*",
    "ext-pdo_sqlite": "*",
    "ext-mbstring": "*",
    "anthropic-ai/sdk": "^1.8",
    "guzzlehttp/guzzle": "^7.9"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": { "psr-4": { "MessengerBot\\": "src/" } },
  "autoload-dev": { "psr-4": { "MessengerBot\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit" }
}
